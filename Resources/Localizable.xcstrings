    "info.habitPage.goal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How days without a mark count. Allowed skips: up to N unmarked days in a row are fine, longer runs turn red. Weekly goal: N marks a week; days are never missed, only the week's total counts."
          }
        }
      }
    },
    "info.habitPage.harmful": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A habit you want to get rid of: a mark means it happened. Streaks and shares count the clean days, and there are no missed days."
          }
        }
      }
    },
    "info.habitPage.history": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every week back to the habit's start, newest at the bottom. Tap a day to cycle DONE (and Twice), long press to choose. Marks are written into the note, also for past days."
          }
        }
      }
    },
    "info.habitPage.options": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Color, whether the habit shows up on Today, the part of the day it belongs to, and the Twice mark."
          }
        }
      }
    },
    "info.habitPage.repeatable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not a habit to keep track of but a task that simply repeats (bills, laundry). It is listed under Repeatable tasks on the Habits tab, and its page has no history grid."
          }
        }
      }
    },
    "info.habitPage.showInToday": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On: the habit is in Today's pool (or on the timeline at its reminder times). Off: it stays only here in Habits, where you mark it yourself. Reminders work either way."
          }
        }
      }
    },
    "info.habitPage.stats": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Streaks count scheduled days in a row that are marked (weeks that reached the goal for a weekly goal). Shares are marks over what the scheduled days could give; Partially counts as half, today only once it is marked."
          }
        }
      }
    },
    "info.habitPage.stats.harmful": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a harmful habit streaks and shares count the clean days: scheduled days without a mark."
          }
        }
      }
    },
    "info.habitPage.timeOfDay": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The routine the habit belongs to. Morning habits stand in the pool's Morning section, evening ones in Evening, joined on one plate in the order set in Habits → Routines."
          }
        }
      }
    },
    "info.habitPage.twiceADay": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds the Twice mark: a tap goes none → DONE → Twice → none. With two reminders a day the second DONE from a notification counts as Twice."
          }
        }
      }
    },
    "info.recurrenceEditor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Like Apple Calendar: every day, week, month or year, on chosen weekdays or a day of the month."
          }
        }
      }
    },
    "info.settings.access.calendar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full access to read Calendar. The app never creates or changes events."
          }
        }
      }
    },
    "info.settings.access.notifications": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local notifications for timed habits, timed tasks and reminders."
          }
        }
      }
    },
    "info.settings.access.reminders": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full access to read Reminders. The app never creates or changes reminders."
          }
        }
      }
    },
    "info.settings.calendars": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Events from these calendars are shown on the timeline and can be linked to tasks. Calendar sends their notifications itself."
          }
        }
      }
    },
    "info.settings.clock": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Clock tab and the Lock Screen widget show the time in this zone. The text before the time is shown only in the widget; invisible characters can be typed as \\u{2800} or U+2800."
          }
        }
      }
    },
    "info.settings.colors": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Colors of checkboxes, icons and marks. Each color applies in light and dark appearance, in the app and in widgets."
          }
        }
      }
    },
    "info.settings.day.boundary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before this time the app still shows the previous day."
          }
        }
      }
    },
    "info.settings.day.energyHour": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before this hour tasks that need energy go up in the pool; after it they go down."
          }
        }
      }
    },
    "info.settings.habits.ringOpacity": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How faded the ring of a day not done, or done partly, is on a habit's page, in the Habits list and in the widget. Done and Twice keep the full color."
          }
        }
      }
    },
    "info.settings.notificationImage.habitColor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On: the symbol on a habit notification takes the habit's own color (habits without one keep the habit color). Off: every habit has the habit color."
          }
        }
      }
    },
    "info.settings.notifications": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local notifications with actions right in them: DONE, Partially, Twice, Skip today."
          }
        }
      }
    },
    "info.settings.obsidian.vault": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For “Open in Obsidian”: the vault’s name and where the folder is inside it. A folder in Obsidian’s iCloud folder tells this by itself."
          }
        }
      }
    },
    "info.settings.pastOpacity": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How see-through done tasks and past events are in the pool, on the timeline and in the widget."
          }
        }
      }
    },
    "info.settings.pool.highPriority": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How a high-priority task stands out in the pool and on the timeline: the priority icon before its name, or its whole plate in a soft red."
          }
        }
      }
    },
    "info.settings.pool.startedFill": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How far a started task's blue fill reaches across its plate."
          }
        }
      }
    },
    "info.settings.pool.visible": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many pool rows are visible at once; the rest scroll and are counted below."
          }
        }
      }
    },
    "info.settings.reminderLists": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timed reminders from these lists appear on the timeline and get a notification. The app only reads them."
          }
        }
      }
    },
    "info.settings.timeline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The timeline shows everything with an exact time and the tasks linked to events."
          }
        }
      }
    },
    "info.settings.timeline.bell": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Events with a Calendar alert show a bell in the corner. Every task and habit with a time rings at the time it stands at on the timeline, so they need no bell."
          }
        }
      }
    },
    "info.settings.timeline.dayRange": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start and end of the day shown by the whole-day timeline. An end earlier than the start means after midnight."
          }
        }
      }
    },
    "info.settings.timeline.halves": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The time range of the column. An end earlier than the start means after midnight."
          }
        }
      }
    },
    "info.settings.timeline.hoursAfter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How far ahead the column reaches."
          }
        }
      }
    },
    "info.settings.timeline.hoursBefore": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much of the past the column keeps visible."
          }
        }
      }
    },
    "info.settings.timeline.layout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One wide column that follows “now”, or two fixed halves of the day side by side."
          }
        }
      }
    },
    "info.settings.timeline.range": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hours around now in a column that scrolls, or the whole day from its start to its end fitted into one column."
          }
        }
      }
    },
    "info.settings.timeline.shown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the timeline shows. Hidden tasks with a time and habits with reminders go to the pool instead; hidden events and reminders are not shown at all. Notifications keep working."
          }
        }
      }
    },
    "info.settings.timeline.taskFont": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text size of tasks and events on the timeline."
          }
        }
      }
    },
    "info.settings.today.arrangement": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stacked: the pool above the timeline. Side by side: the pool on the left, the timeline on the right. Pages: the pool and the timeline each take the whole screen and a swipe turns between them; the edge of the other one stays visible. Drag tasks between the pool and the timeline in any of them."
          }
        }
      }
    },
    "info.settings.vault": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The SuperPooperApp folder inside your Obsidian vault in iCloud Drive; inside it, the Task Manager folder. The app sees only this folder."
          }
        }
      }
    },
    "info.settings.widget.arrangement": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stacked: the pool above the timeline. Side by side: the pool and the timeline next to each other. Only the widget changes; it has no pages."
          }
        }
      }
    },
    "info.taskPage.estimate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long the task roughly takes. Sets the block height on the timeline; shorter tasks go first when everything else is equal."
          }
        }
      }
    },
    "info.taskPage.high": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High-priority tasks go higher in the pool."
          }
        }
      }
    },
    "info.taskPage.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The note text (markdown) is edited as plain text and saved automatically."
          }
        }
      }
    },
    "info.taskPage.properties": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They stand at the end of the task’s line in the tasks file."
          }
        }
      }
    },
    "info.taskPage.reminders": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Times of day the habit is planned at. Each one is a block on the timeline and a notification. Add two or more for a habit you do twice a day. No reminders = it stays in the pool."
          }
        }
      }
    },
    "info.taskPage.status": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next actions — picked to do next, the day is built from these. Soonear and Someday — backlog. Waiting — not in the day. The app never lowers a status."
          }
        }
      }
    },
    "info.taskPage.subtasks": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A subtask is a line under this one in the tasks file. A habit’s or a repeatable task’s subtasks repeat with it."
          }
        }
      }
    },
    "info.taskPage.timeZone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None: 09:00 is 09:00 wherever you are. A zone: 09:00 there, at the matching time of your phone."
          }
        }
      }
    },
    "intent.signing.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends a notification when the app's signature runs out within a day. Put it on a daily automation."
          }
        }
      }
    },
    "intent.signing.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check App Signature"
          }
        }
      }
    },
    "intent.signing.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build has no signature that runs out."
          }
        }
      }
    },
    "intent.signing.until %@": {
