    "habits.new.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The habit is created when you go back. Without a name it is called “Unnamed”; if nothing was set, nothing is created."
          }
        }
      }
    },
    "habits.week.count": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
