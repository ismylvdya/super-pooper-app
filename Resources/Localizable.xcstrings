          "stringUnit": {
            "state": "translated",
            "value": "Back"
          }
        }
      }
    },
    "onboarding.calendar.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixed events are anchors of your day. The app reads them; Calendar keeps notifying about them."
          }
        }
      }
    },
    "onboarding.calendar.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar"
          }
        }
      }
    },
    "onboarding.granted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed"
          }
        }
      }
    },
    "onboarding.next": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        }
      }
    },
    "onboarding.notifications.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timed habits and tasks notify you, with Done right in the notification."
          }
        }
      }
    },
    "onboarding.notifications.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications"
          }
        }
      }
