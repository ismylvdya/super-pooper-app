    "info.settings.archive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasks you archived. From here they can go back to This week or Half year."
          }
        }
      }
    },
    "info.settings.calendars": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Events from these calendars are shown on the timeline and can be linked to tasks. Calendar sends their notifications itself."
          }
        }
      }
    },
    "info.settings.day.boundary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before this time the app still shows the previous day."
          }
        }
      }
    },
    "info.settings.day.energyHour": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before this hour tasks that need energy go up in the pool; after it they go down."
          }
        }
      }
    },
    "info.settings.notifications": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local notifications with actions right in them: Done, Partially, Twice, Skip today."
          }
        }
      }
    },
    "info.settings.pool.visible": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many pool rows are visible at once; the rest scroll and are counted below."
          }
        }
      }
    },
    "info.settings.reminderLists": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timed reminders from these lists appear on the timeline and get a notification. The app only reads them."
          }
        }
      }
    },
    "info.settings.timeline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The timeline shows everything with an exact time and the tasks linked to events."
          }
        }
      }
    },
    "info.settings.timeline.eventFont": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text size of events and reminders on the timeline."
          }
        }
      }
    },
    "info.settings.timeline.halves": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The time range of the column. An end earlier than the start means after midnight."
          }
        }
      }
    },
    "info.settings.timeline.hoursAfter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How far ahead the column reaches."
          }
        }
      }
    },
    "info.settings.timeline.hoursBefore": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much of the past the column keeps visible."
          }
        }
      }
    },
    "info.settings.timeline.layout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One wide column that follows “now”, or two fixed halves of the day side by side."
          }
        }
      }
    },
    "info.settings.timeline.taskFont": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text size of tasks on the timeline."
          }
        }
      }
    },
    "info.settings.vault": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Obsidian vault folder in iCloud Drive. Tasks are read from the TaskNotes tasks folder inside it."
          }
        }
      }
    },
    "info.taskPage.due": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One date per task. A backlog task whose date falls in the current week moves to This week. For recurring tasks the date gives the time of day."
          }
        }
      }
    },
    "info.taskPage.energy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Such tasks go up in the pool before the energy hour and down after it."
          }
        }
      }
    },
    "info.taskPage.estimate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long the task roughly takes. Sets the block height on the timeline; shorter tasks go first when everything else is equal."
          }
        }
      }
    },
    "info.taskPage.events": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link the task to a calendar event: before it (Next event) or after it (Previous event). Linked tasks line up on the timeline."
          }
        }
      }
    },
    "info.taskPage.high": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High-priority tasks go higher in the pool."
          }
        }
      }
    },
    "info.taskPage.links": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previous tasks are done before this one and block it until they are done. Next tasks wait for this one. Each link is stored once, in the later task."
          }
        }
      }
    },
    "info.taskPage.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task name is the note’s file name. Changing it renames the file and updates links from other tasks."
          }
        }
      }
    },
    "info.taskPage.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The note text (markdown) is edited as plain text and saved automatically."
          }
        }
      }
    },
    "info.taskPage.pleasant": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unpleasant tasks go before pleasant ones when everything else is equal."
          }
        }
      }
    },
    "info.taskPage.properties": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Properties are stored in the note’s frontmatter, exactly where TaskNotes keeps them."
          }
        }
      }
    },
    "info.taskPage.recurrence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The repeat rule comes from TaskNotes. Marks for today: Done, Partially or Twice. Skip today hides the habit until tomorrow and is not written to the note."
          }
        }
      }
    },
    "info.taskPage.status": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This week — picked for the week, the day is built from these. Half year and Someday — backlog. Waiting — not in the day. The app never lowers a status."
          }
        }
      }
    },
    "info.taskPage.time": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A task with a time is placed on the timeline and gets a notification."
          }
        }
      }
    },
