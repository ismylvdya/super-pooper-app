#include "Shared.xcconfig"

PRODUCT_NAME = SuperPooperApp
PRODUCT_BUNDLE_IDENTIFIER = $(SP_BUNDLE_ID)
INFOPLIST_FILE = Config/App-Info.plist
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = SuperPooperApp
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.productivity
// The Calendar and Reminders usage descriptions live in App-Info.plist: Xcode 16 does not turn INFOPLIST_KEY_* into
// these two keys, and without them iOS never shows the permission prompt (the Allow button then does nothing).
CODE_SIGN_ENTITLEMENTS = Config/SuperPooper.entitlements
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_INCLUDE_ALL_APPICON_ASSETS = NO
ENABLE_PREVIEWS = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
// Debug only: the app's Documents (where `sim.sh load-vault` puts TestVault) show up in Files,
// so the vault picker can choose it in the simulator.
INFOPLIST_KEY_UIFileSharingEnabled[config=Debug] = YES
INFOPLIST_KEY_LSSupportsOpeningDocumentsInPlace[config=Debug] = YES
